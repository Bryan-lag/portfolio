---
import { Image } from "astro:assets";
import tulipaPreview from "../assets/tulipa-preview.png";
---

<section id="projects" class="section" aria-labelledby="projects-title">
  <h2 id="projects-title" class="section-title">Projects</h2>

  <article class="project">
    <div class="preview">
      <Image
        src={tulipaPreview}
        alt="Tulipa online flower shop showing its home page with a featured bouquet"
        widths={[480, 800, 1200]}
        sizes="(max-width: 800px) 100vw, 55vw"
        format="webp"
        loading="lazy"
      />
    </div>

    <div class="details">
      <h3>Tulipa</h3>
      <p class="kind">Online flower shop</p>

      <div class="prose">
        <p>
          A full-stack shop with a product catalog, a shopping cart that never
          goes over the available stock, checkout, order management and
          WhatsApp contact.
        </p>
        <p>
          The React front end is deployed on Vercel and the FastAPI API on
          Render, with PostgreSQL as the database. Docker Compose covers local
          development, and GitHub Actions runs lint, tests and a build on
          every push.
        </p>
      </div>

      <p class="stack">
        React, FastAPI, PostgreSQL, Docker, Tailwind CSS, GitHub Actions
      </p>

      <div class="links">
        <a
          href="https://flores-app-ten.vercel.app/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View Tulipa live demo (opens in a new tab)"
        >
          Live demo 
        </a>
        <a
          href="https://github.com/Bryan-lag/flores-app"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View Tulipa source code on GitHub (opens in a new tab)"
        >
          Source code 
        </a>
      </div>
    </div>
  </article>
</section>

<style>
  .project {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 64px);
    align-items: center;
  }

  .project + .project {
    margin-top: 72px;
  }

  .preview {
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: var(--surface);
  }

  .preview :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  h3 {
    margin: 0;
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1.15;
  }

  .kind {
    margin: 4px 0 20px;
    color: var(--text-muted);
    font-size: 15px;
  }

  .stack {
    margin: 4px 0 24px;
    color: var(--text-muted);
    font-size: 15px;
    line-height: 1.6;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
  }

  .links a {
    color: var(--gold);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .links a:hover {
    color: var(--gold-hover);
  }

  @media (max-width: 800px) {
    .project {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>